# Local application preview; see src/doc/auto-tag-deployment.md.
FROM python:3.10
WORKDIR /app
COPY requirements.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt
COPY src/backend ./src/backend
COPY src/frontend ./src/frontend
COPY src/asset ./src/asset
# Local PR preview only: publish port 8765 on host 127.0.0.1, never publicly.
ENV PAAM_DATA_DIR=/data PAAM_SQL_WEB_ENABLED=1 PYTHONUNBUFFERED=1
EXPOSE 8765
CMD ["python", "-m", "uvicorn", "backend.target_main:app", "--app-dir", "src", "--host", "0.0.0.0", "--port", "8765"]
