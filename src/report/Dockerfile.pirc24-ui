# Isolated M2-UI acceptance only. No real ledger volume or production credentials.
ARG BASE_IMAGE=paam:pirc24-f1a54ad-docker
FROM ${BASE_IMAGE}
ARG REVISION
LABEL org.opencontainers.image.revision=${REVISION}
WORKDIR /app
COPY src/backend ./src/backend
COPY src/frontend ./src/frontend
COPY src/asset ./src/asset
COPY src/test ./src/test
COPY src/script/serve_m2_ui.py ./src/script/serve_m2_ui.py
ENV PYTHONDONTWRITEBYTECODE=1 PAAM_AUTOTAG_REAL_ANALYSIS=0 PAAM_AUTOTAG_SYNTHETIC_ACCEPTANCE=0
EXPOSE 8765
CMD ["python", "src/script/serve_m2_ui.py", "--data-dir", "/data/m2-ui", "--host", "0.0.0.0", "--port", "8765"]
